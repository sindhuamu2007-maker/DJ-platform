# Backend Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ai_dj_platform
JWT_SECRET=replace_with_a_long_random_secret
AI_ENGINE_URL=http://127.0.0.1:5001
ITUNES_COUNTRY=IN
# Optional YouTube Data API v3 key for searching DJ-style songs
YOUTUBE_API_KEY=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# Alternatively, provide a pre-generated Apple Music developer token:
APPLE_MUSIC_DEVELOPER_TOKEN=
