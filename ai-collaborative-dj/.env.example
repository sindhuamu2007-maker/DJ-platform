# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Direct MongoDB URI. If MongoDB is offline, an in-memory high-reliability store is used automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_dj_platform

# Authentication Secret
JWT_SECRET=replace_with_a_long_random_secret

# Python AI Microservice URL
AI_ENGINE_URL=http://127.0.0.1:5001

# Catalog source; full-track playback uses YouTube when YOUTUBE_API_KEY is configured
MUSIC_PROVIDER=demo

# YouTube Data API v3 key enables full-length embedded playback
YOUTUBE_API_KEY=

# Optional Spotify API Credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
