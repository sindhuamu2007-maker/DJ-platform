# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Direct MongoDB URI. If MongoDB is offline, an in-memory high-reliability store is used automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_dj_platform

# Authentication Secret
JWT_SECRET=replace_with_a_long_random_secret

# Python AI Microservice URL
AI_ENGINE_URL=http://127.0.0.1:5001

# Music Provider: 'demo' for royalty-free multi-genre streaming audio; 'spotify' for Spotify API
MUSIC_PROVIDER=demo

# Optional Spotify API Credentials (leave blank to use verified multi-genre demo audio catalog)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
